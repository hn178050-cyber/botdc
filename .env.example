# ===== Discord bot =====
DISCORD_TOKEN=
# ID Discord của owner/admin, nhiều ID cách nhau dấu phẩy
ADMIN_DISCORD_ID=
# Đặt 1 để chỉ chạy web (không đăng nhập Discord) khi dev
DISABLE_BOT=

# ===== Web =====
PORT=3000
# Domain công khai của web (dùng tạo link nhiệm vụ / link shop)
RENDER_DOMAIN=http://localhost:3000
# Đặt 1 khi chạy sau HTTPS để cookie có cờ Secure
COOKIE_SECURE=

# ===== Nhiệm vụ vượt link =====
LINK4M_API_KEY=
LAYMA_TOKEN=
# bbmkts: /dapi?token=...&longurl=...&format=text (25 xu/lần, 1 lần/ngày)
# Có thể dùng alias cũ VUOTNHANH_API_TOKEN nếu chưa đổi tên biến
BBMKTS_API_TOKEN=
# Webhook Discord để cập nhật BXH coin + thông báo trả thưởng tuần
LEADERBOARD_WEBHOOK_URL=

# ===== Nhiệm vụ /star =====
YTB_CHANNEL_URL=
STAR_CHANNEL_NAME=star

# ===== Proxy API (tuỳ chọn, dùng cho Hanami khi HANAMI_USE_PROXY=1) =====
# Cloudflare Worker (https://...) hoặc SOCKS5/WARP (socks5h://user:pass@host:1080).
API_PROXY=
# API_PROXY_KEY=                # nếu Worker đặt secret PROXY_KEY

# ===== Mua cloud (Hanami) =====
HANAMI_TOKEN=
# Bật 1 để các request Hanami đi qua API_PROXY
HANAMI_USE_PROXY=
# Dùng cho edge function đăng ký tài khoản VMOS (services.js)
APIKEY=

# ===== Reg VSPhone =====
VSPHONE_API_URL=
VSPHONE_API_KEY=

# ===== GitHub Gist (lưu kho shop + script plugin) =====
# Token cần quyền `gist` (classic) hoặc Gists: Read and write (fine-grained)
GITHUB_TOKEN=

# ===== Marketplace / ACOIN =====
# Tỷ giá mặc định: 1 ACOIN = 5 coin (10 coin = 2 ACOIN). Admin đổi được trong API.
# Có thể đặt sẵn giá trị khác ở đây (lưu vào KV exchange_coin_per_acoin khi admin đổi).
EXCHANGE_COIN_PER_ACOIN=
# Thư mục lưu chat/order history khi KHÔNG có GITHUB_TOKEN (mặc định ./data)
# Gist dùng để lưu chat/order: KV gist_chat / gist_orders.
MARKETPLACE_DATA_DIR=
